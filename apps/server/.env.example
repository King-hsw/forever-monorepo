# 环境变量清单（变量名 + 生产取值参考）
#
# 本地开发不需要本文件：application.yml 的 ${VAR:默认值} 已指向 docker-compose.dev.yml，
# 直接 `mvn spring-boot:run` 即可起（初始管理员 dev/dev）。本文件的用途是：
#   1. 变量清单/注释（查名字看这里）
#   2. 个人特化（真实高德/AI key、自己的库密码）：复制为 `.env` 后
#      `set -a; source .env; set +a` 启动，不入库
#   3. 生产/测试的必填清单（同名变量由 compose / systemd EnvironmentFile 提供）
#
# 注：“必填”指生产——application-prod.yml 把这些项收回为无默认值的 ${VAR}，少一个即启动失败；
#     本地不填就走 application.yml 的 dev 默认值。.env 已被 .gitignore 排除，真实值严禁提交。

# 数据库（本地默认 localhost:5432/forever、postgres/mysecretpassword，不同才需覆盖）
#SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/forever
#SPRING_DATASOURCE_USERNAME=postgres
#SPRING_DATASOURCE_PASSWORD=mysecretpassword

# 初始管理员（仅 sys_user 表为空时用于建号）；生产必填，本地默认 dev/dev
BLOG_ADMIN_USERNAME=admin
BLOG_ADMIN_PASSWORD=<管理员初始密码>

# 站点名称（邮件 From 显示名、RSS 标题等对外署名）；生产必填，本地默认「补陋阁」
BLOG_SITE_NAME=<站点名称>

# 站点对外地址（邮件绝对链接、RSS、文章 url 字段）；值需以 http(s):// 开头（缺协议会产出相对路径坏链接）；留空 = 邮件降级无链接、文章 url 为 null
#BLOG_SITE_URL=

# 邮件 SMTP（评论通知、启动测试邮件）；生产五项必填。本地默认 localhost:1025（Mailpit）
# 隐式 TLS：生产 true（yml 默认），本地 Mailpit 1025 明文由 application.yml 关成 false，本地无需设
#BLOG_MAIL_SSL_ENABLE=true
# 生产/测试用真实 SMTP(如 163/腾讯):
BLOG_MAIL_HOST=smtp.example.com
BLOG_MAIL_PORT=465
BLOG_MAIL_USERNAME=<SMTP 账号>
BLOG_MAIL_PASSWORD=<SMTP 授权码>
BLOG_MAIL_TO=<启动测试邮件收件人>
BLOG_MAIL_NOTIFY_TO=<评论通知站长收件人>

# 文件存储（RustFS，S3 兼容）；生产四项必填。本地默认已指向容器（endpoint=http://localhost:9000、
# access/secret=rustfsadmin、bucket=forever）；桶 forever 需在 Console http://localhost:9001 手动创建并设公开读
BLOG_STORAGE_ENDPOINT=https://s3.<域名>
BLOG_STORAGE_ACCESS_KEY=<access key>
BLOG_STORAGE_SECRET_KEY=<secret key>
BLOG_STORAGE_BUCKET=forever
#BLOG_STORAGE_PUBLIC_BASE_URL=
#BLOG_STORAGE_PRESIGN_TTL=15m

# 高德 Web Service key（动态页「获取当前位置」逆地理；留空 = 功能关闭）
#BLOG_MOMENTS_AMAP_KEY=

# AI 概要（OpenAI 兼容接口；API Key 留空 = 功能关闭）
#SPRING_AI_OPENAI_API_KEY=
#SPRING_AI_OPENAI_BASE_URL=https://api.openai.com/v1
#SPRING_AI_OPENAI_CHAT_OPTIONS_MODEL=gpt-4o-mini

# 父域 cookie Domain（生产设 .<父域>，本地留空即可跨端口共享登录态）
#AUTH_COOKIE_DOMAIN=
