# ============================================================
# Forever 环境变量清单（变量名 + 生产参考值）
#
# 本地开发不需要本文件：`.env.development`（入库）已带好 dev 默认值，
# `pnpm dev` 直接起。本文件的用途是：
#   1. 变量清单/注释（改配置时查这里）
#   2. 个人特化：复制为 `.env`（不入库，优先级高于 `.env.development`）
#   3. 生产：复制为 `.env.production` 后 `nuxt build --dotenv .env.production`
#
# 注意：Nuxt 只在 dev 与 build 阶段读取 env 文件；
#       生产「运行时」请通过系统环境变量（systemd / Docker / PM2 等）
#       或 `node .output/server/index.mjs` 前置 env 注入。
# ============================================================

# ---- 服务端 ----

# forever-server 后端地址（仅服务端使用，浏览器请求经 Nitro 的 /api/** 代理转发）
NUXT_API_BASE=http://localhost:8080

# ---- 客户端公开 ----

# 站点对外地址：sitemap.xml、rss.xml、SEO canonical / OG 链接等绝对 URL 的前缀
NUXT_PUBLIC_SITE_URL=https://forever.example.com

# 浏览器端直接访问的 API 地址。
# 默认留空 = 同源（走 Nitro 代理路由），一般无需修改；
# 仅当前后端与前端不同域部署时才需要填写
NUXT_PUBLIC_API_BASE=

# refresh cookie 的 Secure 属性。默认 true（生产 https）；
# 本地 HTTP / 局域网 IP 访问必须关，否则浏览器丢弃 cookie（已由 .env.development 设好）
# NUXT_AUTH_COOKIE_SECURE=false
