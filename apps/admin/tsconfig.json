{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "sourceMap": true,
    "lib": ["esnext", "dom"],
    "types": ["vite/client", "tdesign-vue-next/global"],
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue"
  ],
  "compileOnSave": false
}
