{
  "name": "forever-admin",
  "version": "0.14.0",
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "vite --mode development",
    "dev:open": "vite --open --mode development",
    "build:test": "vite build --mode test",
    "build": "vue-tsc --noEmit && vite build --mode release",
    "typecheck": "vue-tsc --noEmit",
    "build:type": "vue-tsc --noEmit",
    "preview": "vite preview",
    "lint": "eslint --ext .vue,.js,.jsx,.ts,.tsx ./ --max-warnings 0",
    "lint:fix": "eslint --ext .vue,.js,jsx,.ts,.tsx ./ --max-warnings 0 --fix",
    "stylelint": "stylelint src/**/*.{html,vue,css,sass,less}",
    "stylelint:fix": "stylelint --fix src/**/*.{html,vue,css,sass,less}",
    "test": "echo \"no test specified,work in process\""
  },
  "dependencies": {
    "@tiptap/core": "3.30.2",
    "@tiptap/extension-code": "3.30.2",
    "@tiptap/extension-code-block-lowlight": "3.30.2",
    "@tiptap/extension-image": "3.30.2",
    "@tiptap/extension-table": "3.30.2",
    "@tiptap/markdown": "3.30.2",
    "@tiptap/pm": "3.30.2",
    "@tiptap/starter-kit": "3.30.2",
    "@tiptap/vue-3": "3.30.2",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "highlight.js": "^11.12.0",
    "lightningcss": "^1.32.0",
    "lodash": "^4.18.1",
    "lowlight": "^3.3.0",
    "marked": "^17.0.6",
    "marked-highlight": "^2.2.4",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "qs": "^6.15.3",
    "spark-md5": "^3.0.2",
    "tdesign-icons-vue-next": "^0.4.4",
    "tdesign-vue-next": "^1.20.2",
    "tvision-color": "^1.6.0",
    "vue": "^3.5.39",
    "vue-i18n": "^11.4.6",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.1.0",
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@types/echarts": "^5.0.0",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.9.4",
    "@types/nprogress": "^0.2.3",
    "@types/qs": "^6.15.1",
    "@types/spark-md5": "^3.0.5",
