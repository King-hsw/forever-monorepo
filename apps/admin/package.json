    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/compiler-sfc": "~3.5.42",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-vue-scoped-css": "^3.1.1",
    "globals": "^17.7.0",
    "less": "^4.6.7",
    "lint-staged": "^17.0.8",
    "postcss-html": "^1.8.1",
    "postcss-less": "^6.0.0",
    "prettier": "^3.9.6",
