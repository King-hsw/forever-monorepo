# ============================================================
# Monorepo 根级 pnpm 配置
#
# 注意：pnpm 只读「workspace 根」的 .npmrc。
# 原先 apps/admin/.npmrc、apps/web/.npmrc 这类子目录配置一律不生效，已删除。
# ============================================================

# 依赖真实落到各包的 node_modules（pnpm 默认值，显式声明以固定行为）
# Nuxt / Vite / TDesign 这套工具链对 PnP 兼容不佳，不要改成 pnp
node-linker=isolated

# 不要 engine-strict：各包 engines 不一致时会让整个 workspace 装不上
engine-strict=false

# 国内网络可解除下一行注释加速下载。
# GitHub Runner（境外）上不建议开——npmmirror 的 CDN 在境外反而更慢，CI 会变慢。
# registry=https://registry.npmmirror.com
